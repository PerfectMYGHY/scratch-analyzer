{
    // 伪代码翻译器配置 (pcode 模式)
    // 用途：生成不依赖运行时的伪代码，用于代码分析、相似度检测
    // 生成的语言风格：类似 Python 的伪代码
    // 可用参数占位符：%[参数名]%

    // 运动
    "motion_gotoxy": "goto_xy(%[X]%, %[Y]%)",
    "motion_glideto": "glide_to(%[SECS]%, %[TO]%)",
    "motion_turnright": "turn_right(%[DEGREES]%)",
    "motion_turnleft": "turn_left(%[DEGREES]%)",
    "motion_movesteps": "move_steps(%[STEPS]%)",
    "motion_goto": "goto(%[TO]%)",
    "motion_glidesecstoxy": "glide_to_xy(%[SECS]%, %[X]%, %[Y]%)",
    "motion_pointtowards": "set_direction_to(%[TOWARDS]%)",
    "motion_pointindirection": "set_direction(%[DIRECTION]%)",
    "motion_changexby": "change_x_by(%[DX]%)",
    "motion_setx": "set_x(%[X]%)",
    "motion_changeyby": "change_y_by(%[DY]%)",
    "motion_sety": "set_y(%[Y]%)",
    "motion_ifonedgebounce": "turn_on_bounce()",
    "motion_setrotationstyle": "set_rotation_style(%[STYLE]%)",
    "motion_xposition": "spirit.x",
    "motion_yposition": "spirit.y",
    "motion_direction": "spirit.direction",
    // 外观
    "looks_say": "say(%[MESSAGE]%)",
    "looks_sayforsecs": "say_for(%[MESSAGE]%, %[SECS]%)",
    "looks_switchcostumeto": "switch_costume_to(%[COSTUME]%)",
    "looks_nextcostume": "next_costume()",
    "looks_switchbackdropto": "switch_backdrop_to(%[BACKDROP]%)",
    "looks_nextbackdrop": "next_backdrop()",
    "looks_changesizeby": "change_size_by(%[CHANGE]%)",
    "looks_setsizeto": "set_size_to(%[SIZE]%)",
    "looks_seteffectto": "set_effect_to(%[EFFECT]%, %[VALUE]%)",
    "looks_changeeffectby": "change_effect_by(%[EFFECT]%, %[CHANGE]%)",
    "looks_cleargraphiceffects": "clear_effects()",
    "looks_show": "show()",
    "looks_hide": "hide()",
    "looks_gotofrontback": "go_to_front_back(%[FRONT_BACK]%)",
    "looks_goforwardbackwardlayers": "go_forward_backward(%[NUM]%, %[FORWARD_BACKWARD]%)",
    "looks_size": "spirit.size",
    "looks_costumenumbername": "get_costume(%[NUMBER_NAME]%)",
    "looks_backdropnumbername": "get_backdrop(%[NUMBER_NAME]%)",
    // 声音
    "sound_play": "play_sound(%[SOUND_MENU]%)",
    "sound_playuntildone": "play_sound_until_done(%[SOUND_MENU]%)",
    "sound_stopallsounds": "stop_all_from()",
    "sound_seteffectto": "set_sound_effect_to(%[EFFECT]%, %[VALUE]%)",
    "sound_changeeffectby": "change_sound_effect_by(%[EFFECT]%, %[VALUE]%)",
    "sound_cleareffects": "clear_sound_effects()",
    "sound_changevolumeby": "change_volume_by(%[VOLUME]%)",
    "sound_setvolumeto": "set_volume_to(%[VOLUME]%)",
    "sound_volume": "sprite.volume",
    // 事件
    "event_broadcast": "broadcast(%[BROADCAST_INPUT]%)",
    "event_broadcastandwait": "broadcast_and_wait(%[BROADCAST_INPUT]%)",
    // 控制
    "control_wait": "wait_for(%[DURATION]%)",
    "control_repeat": "for _ in range(%[TIMES]%):",
    "control_forever": "while True:",
    "control_if": "if %[CONDITION]%:",
    "control_if_else": "if %[CONDITION]%:",
    "control_if_else_before_2": "else:",
    "control_if_end": "", // Python的if不需要结束符号，但是其他语言可能需要
    "control_wait_until": "wait_until(lambda: %[CONDITION]%)",
    "control_repeat_until": "while not (%[CONDITION]%):",
    "control_while": "while (%[CONDITION]%):",
    "control_stop": "stop(%[STOP_OPTION]%)",
    "control_create_clone_of": "clone(%[CLONE_OPTION]%)",
    "control_delete_this_clone": "delete_this_clone(task_id)",
    // 侦测
    "sensing_touchingobject": "is_touching(%[TOUCHINGOBJECTMENU]%)",
    "sensing_touchingcolor": "is_touching_color(%[COLOR]%)",
    "sensing_coloristouchingcolor": "is_color_touching_color(%[COLOR]%, %[COLOR2]%)",
    "sensing_distanceto": "get_distance_to(%[DISTANCETOMENU]%)",
    "sensing_askandwait": "ask(%[QUESTION]%)",
    "sensing_answer": "get_last_answer()",
    "sensing_keypressed": "is_key_pressed(%[KEY_OPTION]%)",
    "sensing_mousedown": "is_mouse_down()",
    "sensing_mousex": "get_mouse_x()",
    "sensing_mousey": "get_mouse_y()",
    "sensing_setdragmode": "set_drag_mode(%[DRAG_MODE]%)",
    "sensing_loudness": "(-1)",
    "sensing_timer": "get_timer()",
    "sensing_resettimer": "reset_timer()",
    "sensing_of": "property_of_sprite(%[OBJECT]%, %[PROPERTY]%)",
    "sensing_current": "get_part_of_current_time(%[CURRENTMENU]%)",
    "sensing_dayssince2000": "get_days_since_2000()",
    "sensing_username": "get_user_name()",
    // 运算
    "operator_add": "(%[NUM1]% + %[NUM2]%)",
    "operator_subtract": "(%[NUM1]% - %[NUM2]%)",
    "operator_multiply": "(%[NUM1]% * %[NUM2]%)",
    "operator_divide": "(%[NUM1]% / %[NUM2]%)",
    "operator_random": "randnum(%[FROM]%, %[TO]%)",
    "operator_lt": "(%[OPERAND1]% < %[OPERAND2]%)",
    "operator_gt": "(%[OPERAND1]% > %[OPERAND2]%)",
    "operator_equals": "(%[OPERAND1]% == %[OPERAND2]%)",
    "operator_and": "(%[OPERAND1]% and %[OPERAND2]%)",
    "operator_or": "(%[OPERAND1]% or %[OPERAND2]%)",
    "operator_not": "(not %[OPERAND]%)",
    "operator_join": "(str(%[STRING1]%) + str(%[STRING2]%))",
    "operator_letter_of": "letter_of(str(%[STRING]%), %[LETTER]%)",
    "operator_length": "len(str(%[STRING]%))",
    "operator_contains": "(str(%[STRING2]%).lower() in str(%[STRING1]%).lower())",
    "operator_mod": "mod(%[NUM1]%, %[NUM2]%)", // Scratch取模使用了特殊算法以应对负数，需要区分
    "operator_round": "round(%[NUM]%)",
    "operator_mathop": "math_operation(%[OPERATOR]%, %[NUM]%)",
    // 变量
    "data_variable": "get_variable(%[VARIABLE]%)",
    "data_setvariableto": "set_variable(%[VARIABLE]%, %[VALUE]%)",
    "data_changevariableby": "change_variable_by(%[VARIABLE]%, %[VALUE]%)",
    "data_showvariable": "show_variable(%[VARIABLE]%)",
    "data_hidevariable": "hide_variable(%[VARIABLE]%)",
    "data_listcontents": "get_list(%[LIST]%)", // Scratch中列表的内容是一个字符串，元素之间用空格分隔（如果都是单个字符还会不分隔）
    "data_addtolist": "add_to_list(%[LIST]%, %[ITEM]%)",
    "data_deleteoflist": "delete_index_of_list(%[LIST]%, %[INDEX]%)",
    "data_deletealloflist": "clear_list(%[LIST]%)",
    "data_insertatlist": "inset_at_list(%[LIST]%, %[INDEX]%, %[ITEM]%)",
    "data_replaceitemoflist": "replace_item_of_list(%[LIST]%, %[INDEX]%, %[ITEM]%)",
    "data_itemoflist": "get_item_of_list(%[LIST]%, %[INDEX]%)",
    "data_itemnumoflist": "find_index_of_list(%[LIST]%, %[ITEM]%)",
    "data_lengthoflist": "get_length_of_list(%[LIST]%)",
    "data_listcontainsitem": "contain_item_of_list(%[LIST]%, %[ITEM]%)",
    "data_showlist": "show_list(%[LIST]%)",
    "data_hidelist": "hide_list(%[LIST]%)",
    // 自定义积木
    "procedures_call": "call(%[FUNC_NAME]%, %[ARGS]%)",
    "argument_reporter_string_number": "custom_get_param(str(%[VALUE]%))",
    "argument_reporter_boolean": "custom_get_param(str(%[VALUE]%))",
    // 画笔扩展
    "pen_clear": "pen_clear()",
    "pen_penDown": "pen_pen_down()",
    "pen_penUp": "pen_pen_up()",
    "pen_setPenColorToColor": "pen_set_color(%[COLOR]%)",
    "changePenColorParamBy": "pen_change_color_param(%[COLOR_PARAM]%, %[VALUE]%)",
    "pen_setPenColorParamTo": "pen_set_color_param(%[COLOR_PARAM]%, %[VALUE]%)",
    "pen_changePenSizeBy": "pen_change_width(%[SIZE]%)",
    "pen_setPenSizeTo": "pen_set_width(%[SIZE]%)",
    "pen_menu_colorParam": "%[colorParam]%" // 扩展特殊配置
}