{
    // 此文件用于存储目标语言的一些内部代码的生成模板
    // 目标语言: python
    // 语言类型: 理论上可运行代码
    // 本文件的占位符使用format格式
    
    "data_variable_getter": "Scratch.getVariable(instance, \"{value}\")", // 适用于全局替换的模板（此特性为了解决Scratch老版遗留问题）
    "function_definition": "async def {func_name}(instance, task_id):", // 函数定义模板，{func_name}为函数名
    "blank_substack": "pass", // Python 语言对于空子代码（如if/循环等语句函数体）需要用pass标记
    "error_throw": "raise RuntimeError({content}) # {comment}", // 抛出错误代码
    "exit_function": "return", // 函数结束语句
    "is_current_clone": "if instance.is_clone:", // 判断是否是克隆体
    "one_line_comment": "#", // 单行注释以#开头
    "frame_wait": "yield # 让出控制权" // 请看内部注释
}